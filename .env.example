# NetGuardian Environment Configuration

# Application
PROJECT_NAME="NetGuardian"
ENVIRONMENT="LAB-SIMULATION"
DEMO_MODE=true
SECRET_KEY="netguardian-super-secret-production-key-ccna-2026"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
# Default local SQLite:
DATABASE_URL="sqlite:///./netguardian.db"
# Production PostgreSQL alternative:
# DATABASE_URL="postgresql://netguardian:netguardian_pass@localhost:5432/netguardian_db"

# Monitoring
MONITORING_INTERVAL_SECONDS=10
METRIC_RETENTION_HOURS=72

# Real SSH Hardware Execution (Requires explicit authorization)
ALLOW_REAL_SSH=false
