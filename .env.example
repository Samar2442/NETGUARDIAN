# ==============================================================================
# NetGuardian Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' and configure according to your deployment environment.
# NEVER commit actual secrets, API tokens, or production passwords to version control.

# ------------------------------------------------------------------------------
# 1. APPLICATION & ENVIRONMENT
# ------------------------------------------------------------------------------
PROJECT_NAME="NetGuardian"
TAGLINE="Detect. Understand. Predict. Recover."

# Deployment environment: "DEV" (local development) or "PROD" (production)
ENVIRONMENT=DEV

# In DEV, simulation mode is active. In PROD, set DEMO_MODE=false
DEMO_MODE=true

# Set to true only in authorized network labs with real SSH connectivity
ALLOW_REAL_SSH=false

# ------------------------------------------------------------------------------
# 2. SECURITY & AUTHENTICATION
# ------------------------------------------------------------------------------
# JWT signing secret key:
# - In DEV: If omitted, a secure ephemeral random key is generated automatically.
# - In PROD: Mandatory! Must be at least 32 characters long.
# - Generate a production secret using:
#     python -c "import secrets; print(secrets.token_hex(32))"
# WARNING: Known placeholders (e.g. REPLACE_WITH_A_SECURE_SECRET) are rejected in PROD.
SECRET_KEY=REPLACE_WITH_A_SECURE_SECRET

# JWT Algorithm and Access Token Expiration
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Initial administrative account credentials for database seeding:
# - In DEV: If omitted, random temporary passwords will be stored in .demo_credentials.
# - In PROD: Mandatory! You must provide strong unique credentials.
ADMIN_PASSWORD=REPLACE_WITH_STRONG_ADMIN_PASSWORD
ENGINEER_PASSWORD=REPLACE_WITH_STRONG_ENGINEER_PASSWORD
VIEWER_PASSWORD=REPLACE_WITH_STRONG_VIEWER_PASSWORD

# ------------------------------------------------------------------------------
# 3. CORS (CROSS-ORIGIN RESOURCE SHARING)
# ------------------------------------------------------------------------------
# Comma-separated list of approved frontend origins.
# - Must be valid http/https URLs with host:port and no path, query, or fragment.
# - Wildcards (*) are strictly rejected in PROD.
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Comma-separated list of trusted reverse proxy IPs (for X-Forwarded-Proto HSTS)
TRUSTED_PROXIES=127.0.0.1,::1

# ------------------------------------------------------------------------------
# 4. DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# Default local SQLite:
DATABASE_URL=sqlite:///./netguardian.db

# Production PostgreSQL alternative:
# DATABASE_URL=postgresql://netguardian_user:your_db_password@localhost:5432/netguardian_db

# ------------------------------------------------------------------------------
# 5. MONITORING & ENGINE INTERVALS
# ------------------------------------------------------------------------------
MONITORING_INTERVAL_SECONDS=10
METRIC_RETENTION_HOURS=72
